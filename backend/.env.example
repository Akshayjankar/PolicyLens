# Google Gemini API key — get free at https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Gemini model (defaults to gemini-1.5-flash; can use gemini-2.0-flash, gemini-1.5-pro)
GEMINI_MODEL=gemini-1.5-flash

# SQLite — no setup needed, DB file is created automatically at backend/policylens.db
# To switch to PostgreSQL later, uncomment and fill in this line:
# DATABASE_URL=postgresql://postgres:password@localhost:5432/policylens

# Chrome extension origin (restrict in production)
ALLOWED_ORIGINS=chrome-extension://your_extension_id_here
